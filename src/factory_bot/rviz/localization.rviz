Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: factory_map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/RobotModel
      Name: robot1 model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot1/robot_description
        Durability Policy: Transient Local
      TF Prefix: robot1
    - Class: rviz_default_plugins/RobotModel
      Name: robot2 model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot2/robot_description
        Durability Policy: Transient Local
      TF Prefix: robot2
    - Class: rviz_default_plugins/LaserScan
      Name: robot1 scan
      Enabled: true
      Topic:
        Value: /robot1/scan
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Size (m): 0.05
      Style: Points
    - Class: rviz_default_plugins/LaserScan
      Name: robot2 scan
      Enabled: true
      Topic:
        Value: /robot2/scan
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 60; 120; 255
      Size (m): 0.05
      Style: Points
    - Class: rviz_default_plugins/Pose
      Name: robot1 ICP pose
      Enabled: true
      Topic:
        Value: /robot1/icp_pose
      Shape: Arrow
      Color: 255; 60; 60
    - Class: rviz_default_plugins/Pose
      Name: robot2 ICP pose
      Enabled: true
      Topic:
        Value: /robot2/icp_pose
      Shape: Arrow
      Color: 60; 120; 255
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 50
      X: 5
      Y: 5
