Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: robot1 model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot1/robot_description
      TF Prefix: robot1
    - Class: rviz_default_plugins/LaserScan
      Name: robot1 scan
      Enabled: true
      Topic:
        Value: /robot1/scan
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Size (m): 0.05
      Style: Points
    - Class: rviz_default_plugins/RobotModel
      Name: robot2 model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot2/robot_description
      TF Prefix: robot2
    - Class: rviz_default_plugins/LaserScan
      Name: robot2 scan
      Enabled: true
      Topic:
        Value: /robot2/scan
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 60; 160; 255
      Size (m): 0.05
      Style: Points
  Global Options:
    Fixed Frame: robot1/odom
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
