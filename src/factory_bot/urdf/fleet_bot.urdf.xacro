<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fleet_bot">

  <!-- ===== 1. Input and sizes ===== -->
  <xacro:arg name="ns" default="robot1"/>
  <xacro:property name="ns" value="$(arg ns)"/>

  <xacro:property name="wheel_radius"     value="0.050"/>
  <xacro:property name="wheel_separation" value="0.350"/>
  <xacro:property name="wheel_width"      value="0.035"/>
  <xacro:property name="base_length"      value="0.360"/>
  <xacro:property name="base_width"       value="0.300"/>
  <xacro:property name="base_height"      value="0.120"/>
  <xacro:property name="base_mass"        value="5.0"/>
  <xacro:property name="wheel_mass"       value="0.4"/>
  <xacro:property name="caster_radius"    value="0.025"/>
  <xacro:property name="body_rgba" value="${'0.20 0.47 0.96 1' if ns == 'robot1' else '0.94 0.55 0.16 1'}"/>

  <xacro:arg name="cameras" default="true"/>
  <xacro:arg name="camera_width" default="512"/>
  <xacro:arg name="camera_height" default="288"/>
  <xacro:arg name="camera_rate" default="8.0"/>
  <xacro:property name="robot_visual" value="${'blue' if ns == 'robot1' else 'amber'}"/>

  <!-- ===== 2. Mass helpers (physics needs inertia for every moving part) ===== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}" izz="${m*r*r/2}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ===== 3. Body ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://factory_bot/models/robot_premium/meshes/body_${robot_visual}.obj"/></geometry>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height/2}"/>
  </joint>

  <!-- ===== 4. Wheels: one block used twice ===== -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><mesh filename="package://factory_bot/models/robot_premium/meshes/wheel.obj"/></geometry>
      </visual>
       <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2} ${-base_height/2}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.001"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ===== 5. Front caster: a frictionless ball so the robot does not tip ===== -->
  <link name="caster_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${base_length/2 - 0.05} 0 ${-base_height/2 - wheel_radius + caster_radius}"/>
  </joint>
  
  <link name="rear_caster_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="${-(base_length/2 - 0.05)} 0 ${-base_height/2 - wheel_radius + caster_radius}"/>
  </joint>

  <!-- ===== 6. Sensor mounts (the sensors themselves are added in Step 6) ===== -->
  <link name="laser_link">
    <!-- Housing drawn BELOW the sensor point: the lidar must not see its own case. -->
    <visual>
      <geometry><mesh filename="package://factory_bot/models/robot_premium/meshes/lidar.obj"/></geometry>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.10 0 ${base_height/2 + 0.06}"/>
  </joint>

  <!-- Low front safety lidar: ahead of our own shell, at the other robot's body height.
       The original 360-degree SLAM lidar and its reference-map scan plane stay unchanged. -->
  <link name="obstacle_laser_link">
    <visual>
      <origin xyz="-0.015 0 0"/>
      <geometry><box size="0.018 0.045 0.018"/></geometry>
      <material name="safety_lidar_graphite"><color rgba="0.06 0.08 0.09 1"/></material>
    </visual>
  </link>
  <joint name="obstacle_laser_joint" type="fixed">
    <parent link="base_link"/><child link="obstacle_laser_link"/>
    <origin xyz="0.205 0 0.010"/>
  </joint>

  <!-- Low rear safety lidar, outside our shell. It is not an ICP/SLAM input. -->
  <link name="rear_obstacle_laser_link">
    <visual>
      <origin xyz="-0.015 0 0"/>
      <geometry><box size="0.018 0.045 0.018"/></geometry>
      <material name="safety_lidar_graphite"/>
    </visual>
  </link>
  <joint name="rear_obstacle_laser_joint" type="fixed">
    <parent link="base_link"/><child link="rear_obstacle_laser_link"/>
    <origin xyz="-0.205 0 0.010" rpy="0 0 3.141592653589793"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02"/>
  </joint>
  
  <!-- Visual camera lens is in the shell. Massless fixed sensor frames retain original dynamics. -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.189 0 0.052"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <xacro:include filename="$(find factory_bot)/urdf/fleet_bot.ros2_control.xacro"/>
  
  <xacro:include filename="$(find factory_bot)/urdf/fleet_bot.gazebo.xacro"/>
  
</robot>
