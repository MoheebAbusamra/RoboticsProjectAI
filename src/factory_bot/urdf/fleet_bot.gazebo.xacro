<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control inside Gazebo, running in this robot's namespace (Step 5) -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find factory_bot)/config/fleet_controllers.yaml</parameters>
      <ros>
        <namespace>${ns}</namespace>
      </ros>
    </plugin>
        <!-- GROUND TRUTH: the simulator's exact position of this robot, in Gazebo coordinates.
         Used ONLY to steer the scripted mapping drive and to measure localization error.
         SLAM and localization never use it. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>${ns}/base_footprint</robot_base_frame>
      <odom_topic>${ns}/ground_truth</odom_topic>
      <tf_topic>${ns}/ground_truth_tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <!-- LIDAR: 360 beams, 10 scans per second, 0.12 to 12 m -->
  <gazebo reference="laser_link">
    <sensor name="lidar_${ns}" type="gpu_lidar">
      <topic>${ns}/scan</topic>
      <gz_frame_id>${ns}/laser_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <!-- Ordinary geometry plus the forklift's lidar-only outer bounding box. -->
        <visibility_mask>2415919103</visibility_mask>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- 91 low front rays: body-height obstacle detection, not a SLAM input. -->
  <gazebo reference="obstacle_laser_link">
    <sensor name="obstacle_lidar_${ns}" type="gpu_lidar">
      <topic>${ns}/obstacle_scan</topic>
      <gz_frame_id>${ns}/obstacle_laser_link</gz_frame_id>
      <update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
      <lidar>
        <visibility_mask>2415919103</visibility_mask>
        <scan><horizontal><samples>91</samples><resolution>1</resolution>
          <min_angle>-0.7853981633974483</min_angle><max_angle>0.7853981633974483</max_angle>
        </horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Rear half-plane at body height: full-width reverse clearance, not mapping. -->
  <gazebo reference="rear_obstacle_laser_link">
    <sensor name="rear_obstacle_lidar_${ns}" type="gpu_lidar">
      <topic>${ns}/rear_obstacle_scan</topic>
      <gz_frame_id>${ns}/rear_obstacle_laser_link</gz_frame_id>
      <update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
      <lidar>
        <visibility_mask>2415919103</visibility_mask>
        <scan><horizontal><samples>181</samples><resolution>1</resolution>
          <min_angle>-1.5707963267948966</min_angle><max_angle>1.5707963267948966</max_angle>
        </horizontal></scan>
        <range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- First-person RGB camera. Sensor forward = +X; ROS optical frame = +Z forward. -->
  <xacro:if value="$(arg cameras)">
    <gazebo reference="camera_link">
      <sensor name="front_camera_${ns}" type="camera">
        <topic>${ns}/camera/image_raw</topic>
        <gz_frame_id>${ns}/camera_optical_frame</gz_frame_id>
        <update_rate>$(arg camera_rate)</update_rate>
        <always_on>true</always_on><visualize>false</visualize>
        <camera>
          <!-- Exclude lidar-only collision envelopes from RGB images. -->
          <visibility_mask>268435455</visibility_mask>
          <camera_info_topic>${ns}/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>$(arg camera_width)</width><height>$(arg camera_height)</height><format>R8G8B8</format><anti_aliasing>2</anti_aliasing></image>
          <clip><near>0.025</near><far>24.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- IMU: measures turning and acceleration, 100 times per second -->
  <gazebo reference="imu_link">
    <sensor name="imu_${ns}" type="imu">
      <topic>${ns}/imu</topic>
      <gz_frame_id>${ns}/imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- Wheel grip: driven wheels grip, the caster slides (Step 5) -->
  <gazebo reference="left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="rear_caster_link">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>
</robot>
